<%# locals: () -%>
<%# Footer.astro: the logo and the disclaimer, the footer global's link
    columns, the social links, then the copyright and legal links. %>
<% footer = mulebox_global(:footer) %>
<% social = Array(mulebox_opt(mulebox_site, :social)).select { it.url.present? } %>
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__about">
      <% if mulebox_opt(footer, :logo).present? %>
        <%= website_image_tag mulebox_opt(footer, :logo), alt: "#{mulebox_name} logo", sizes: "160px", class: "site-footer__logo" %>
      <% else %>
        <%= image_tag mulebox_asset_path("logo.png"), class: "site-footer__logo", alt: "#{mulebox_name} logo", width: 160, height: 29, loading: "lazy" %>
      <% end %>
      <% if mulebox_opt(footer, :disclaimer).present? %><p><%= mulebox_opt(footer, :disclaimer) %></p><% end %>
    </div>
    <% Array(footer&.columns).each_with_index do |column, index| %>
      <%# herb:key index %>
      <div class="site-footer__column">
        <% if column.heading.present? %><h2><%= column.heading %></h2><% end %>
        <nav aria-label="<%= column.heading.presence || "Footer" %>">
          <ul>
            <% Array(column.items).each_with_index do |item, row| %>
              <%# herb:key row %>
              <li><%= mulebox_link_to item.label, mulebox_href(item.link) %></li>
            <% end %>
          </ul>
        </nav>
      </div>
    <% end %>
    <% if social.any? %>
      <div class="site-footer__column">
        <h2><%= mulebox_opt(footer, :social_heading).presence || "Social Media" %></h2>
        <div class="site-footer__social"><%= render "website/shared/social", links: social %></div>
      </div>
    <% end %>
  </div>
  <div class="container site-footer__bottom">
    <p><%= (footer&.copyright.presence || "© {year} #{mulebox_name}. All rights reserved.").gsub("{year}", mulebox_year.to_s) %></p>
    <% legal = Array(mulebox_opt(footer, :legal)).select { it.label.present? } %>
    <% if legal.any? %>
      <div class="site-footer__legal">
        <% legal.each_with_index do |item, index| %>
          <%# herb:key index %>
          <%= link_to item.label, mulebox_href(item.link) %>
        <% end %>
      </div>
    <% end %>
  </div>
</footer>
