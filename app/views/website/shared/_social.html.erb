<%# locals: (links:) -%>
<%# Social links (Site details), each as its network's mark. %>
<% links.each_with_index do |link, index| %>
  <%# herb:key index %>
  <% network = mulebox_plain(link.network).downcase %>
  <a class="social" href="<%= mulebox_href(link.url) %>" target="_blank" rel="noopener"><%= mulebox_icon(network.to_sym) %><span class="visually-hidden"><%= link.network %> (opens in a new tab)</span></a>
<% end %>
