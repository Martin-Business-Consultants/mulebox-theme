<%# locals: (data:) -%>
<% hero_classes = class_names("hero", "hero--image": data.image_id.present?) %>
<section class="<%= hero_classes %>">
  <% if data.image_id.present? %>
    <%= website_image_tag data.image_id, class: "hero__image", alt: "", loading: :eager, fetchpriority: :high %>
  <% end %>
  <div class="container hero__body">
    <h1><%= data.heading %></h1>
    <% if data.subheading.present? %><div class="hero__lead"><%= website_rich_text data.subheading %></div><% end %>
    <%= render "website/shared/ctas", ctas: data.ctas %>
  </div>
</section>
