<%# locals: (data:) -%>
<%# WhatFitTable.astro: boxes by home size and how furnished it is. %>
<% columns = Array(data.columns) %>
<section class="container what-fits">
  <div class="framed">
    <table class="what-fits__table">
      <% if columns.any? %>
        <thead>
          <tr>
            <% columns.each_with_index do |column, index| %>
              <%# herb:key index %>
              <th scope="col"><%= column %></th>
            <% end %>
          </tr>
        </thead>
      <% end %>
      <tbody>
        <% Array(data.rows).select { it.size.present? }.each_with_index do |row, index| %>
          <%# herb:key index %>
          <tr>
            <th scope="row"><%= row.size %></th>
            <td><%= row.light %></td>
            <td><%= row.moderate %></td>
            <td><%= row.heavy %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
