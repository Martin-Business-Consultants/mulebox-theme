<%# locals: (data:) -%>
<%# HourlyMovers.astro: the movers, their rates, and the note. %>
<section class="container movers">
  <%= content_tag mulebox_heading_tag, data.title, class: "movers__title" %>
  <% if data.image.present? %><%= website_image_tag data.image, alt: "", sizes: "(min-width: 1200px) 1130px, 100vw", class: "movers__image" %><% end %>
  <div class="movers__body">
    <div class="framed">
      <table class="movers__table">
        <tbody>
          <% Array(data.movers).select { it.name.present? }.each_with_index do |mover, index| %>
            <%# herb:key index %>
            <tr>
              <td>
                <% if (href = mulebox_href(mover.url)) %><%= mulebox_link_to mover.name, href %><% else %><%= mover.name %><% end %>
                <% if mover.phone.present? %> | <%= mover.phone %><% end %>
              </td>
              <td><%= mover.rate %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if data.footnote.present? %><p class="movers__footnote"><%= data.footnote %></p><% end %>
    <% if data.note.present? %>
      <div class="movers__note">
        <% if data.note_heading.present? %><p class="movers__note-heading"><%= data.note_heading %></p><% end %>
        <p><%= data.note %></p>
      </div>
    <% end %>
  </div>
</section>
