<%# locals: (data:) -%>
<section class="container block">
  <% if data.heading.present? %><h2><%= data.heading %></h2><% end %>
  <% if data.body.present? %><div class="muted lead"><%= website_rich_text data.body %></div><% end %>
  <% cols = data.columns.presence || "3" %>
  <div class="<%= class_names("grid", "grid--2": cols == "2", "grid--3": cols == "3", "grid--4": cols == "4") %>">
    <% data.cards.each_with_index do |card, index| %>
      <%# herb:key index %>
      <div class="card">
        <% if card.image_id.present? %><%= website_image_tag card.image_id, class: "card__image", sizes: "(min-width: 800px) 33vw, 100vw" %><% end %>
        <h3><%= card.title %></h3>
        <% if card.subtitle.present? %><p class="muted"><%= card.subtitle %></p><% end %>
        <div class="muted"><%= website_rich_text card.description %></div>
        <% if (href = mulebox_href(card.link_url)) %><a href="<%= href %>"><%= card.link_label.presence || "Learn more" %> →</a><% end %>
      </div>
    <% end %>
  </div>
</section>
