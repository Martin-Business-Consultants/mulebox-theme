<%# locals: (data:) -%>
<% cols = data.column_count.presence || "2" %>
<div class="container block <%= class_names("grid", "grid--2": cols == "2", "grid--3": cols == "3", "grid--4": cols == "4") %>">
  <% Array(data.to_h["items"]).each_with_index do |block, index| %>
    <%# herb:key index %>
    <div><%= website_block(block) %></div>
  <% end %>
</div>
